{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-file-size.js\" 2>/dev/null || true",
            "statusMessage": "Vérification de la taille du fichier",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
