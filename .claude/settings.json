{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/taille.js\"",
            "statusMessage": "Plafond de taille (cliquet)",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/globales.js\"",
            "statusMessage": "Pas de globale window.* neuve (cliquet)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
