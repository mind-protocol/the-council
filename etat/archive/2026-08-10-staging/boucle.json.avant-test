      "etat_cibles": {
        "pers:rhaenyra": {
          "type": "observation",
          "apres": "Wat constate qu'elle n'a pas discuté le motif du compte et qu'elle n'a pas demandé pardon cette fois non plus ; les deux demandes n'ont reçu qu'une réponse et demie.",
