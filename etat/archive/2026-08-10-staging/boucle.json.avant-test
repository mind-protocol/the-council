      "empreinte_canonique": "23418c76871ae0d847d0270f7b0b0857f4686f75",
      "reprendre_a": 112252.418,
      "suspendue": false,
      "etat_cibles": {
        "10030": {
          "type": "progression_tache",
          "apres": "La ligne PORTE DE MER est toujours vide et elle a maintenant deux heures : celle du constat de minuit et celle de la relecture d'avant l'aube, portées l'une sous l'autre en tête de la ligne, avec la mention qu'elle a passé la nuit sans oreille. Le feuillet du castellan n'a toujours atteint personne et reste dans sa ceinture, écrit des deux côtés, non contresigné. Le second bras n'est ni tracé ni inventé. Ce qui a bougé cette nuit est du côté de la terre, non de la mer : le cinquième tour de la rampe est ouvert et payé au rôle, et les trois hommes qui la tiennent seront interrogés séparément au banc, deux questions écrites d'avance, avant que la journée fournisse la bouche qui remplira la ligne de mer.",
          "resultat_id": "res:act:le-sanglier:5:1"
        },
        "cour": {
          "type": "observation",
          "apres": "Nul chef de poste ne traverse la cour ; le feuillet reste dans sa main.",
          "resultat_id": "res:act:robert-quince:1:2"
        },
        "porte-de-mer": {
          "type": "fait",
          "apres": "Porte de mer close et barrée, de la main du castellan, à la descente, deux doigts sous la marque ; rien n'accoste tant que la barre est en place.",
          "resultat_id": "res:act:robert-quince:1:1"
        },
        "rulf-corne": {
          "type": "observation",
          "apres": "Rulf Corne venait pour la barre, précisément : porte close à la descente, ses propres gens et deux charrois de la pointe restent dehors jusqu'au flot, et il tient à ce qu'on sache que c'est le castellan qui l'a voulu, non le maître de port. Il ne s'y oppose pas ; il le fait dire.",
          "resultat_id": "res:act:robert-quince:2:1"
        },
        "quince-fouille-des-coques": {
          "type": "observation",
          "apres": "L'étale de demain tombe une heure après l'aube ; Rulf Corne lira le cahier des sorties dans l'heure qui suit, chez lui, à la table du maître de port, et pas ailleurs.",
          "resultat_id": "res:act:robert-quince:2:2"
        },
        "wend": {
          "type": "variation_mesure",
          "apres": "Neuf paniers comptés au seuil, de la main à la main : étoupe, goudron, deux de salaisons éventrées, un de bois de calage. Rien qui se lise, rien qui se tire, rien qui se cache — la fouille de ce qui accoste ne rend toujours rien depuis la nuit du vingt-septième. Et Wend compte ce qui entre, jamais ce qui revient : il ne peut nommer aucune coque venue deux fois depuis le vingt-septième, et n'a jamais mis le pied au mouillage de la pointe, faute de barque et de deux hommes.",
          "resultat_id": "res:act:robert-quince:3:1"
        },
        "pers:le-sanglier": {
          "type": "observation",
          "apres": "La chandelle est descendue au culot et la flamme couche ; il ne lui reste pas de quoi compter trois lunes de demi-tours ni de quoi écrire une ligne de plus. Tout ce qui devait être prêt sans un pas l'est : bourses en deux tas, feuillet des deux questions, cinquième tour ouvert à l'encre, ligne de mer datée et vide. Il attend le jour à sa chaise, la jambe raide devant, la lecture tout haut de sept heures et le banc de huit heures et demie.",
          "resultat_id": "res:act:le-sanglier:5:2"
        },
        "sanglier-six-noms": {
