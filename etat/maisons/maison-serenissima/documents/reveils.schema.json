{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reveils.schema.json",
  "title": "Bibliothèque des causes de réveil de Serenissima",
  "type": "object",
  "required": ["schema", "amorces"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "reveils/1"},
    "amorces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "famille", "texte", "contexte_requis"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "famille": {
            "enum": ["lieu", "ouvrage", "relation", "trace", "possibilite"]
          },
          "texte": {"type": "string", "minLength": 1},
          "contexte_requis": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["lieu", "adresse", "personne", "trace", "possibilite"]
            }
          }
        }
      }
    }
  }
}
