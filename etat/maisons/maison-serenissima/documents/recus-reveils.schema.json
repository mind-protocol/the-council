{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recus-reveils.schema.json",
  "title": "Reçu matériel d'un réveil",
  "type": "object",
  "required": [
    "schema",
    "id",
    "cause",
    "rendu",
    "habitant",
    "session",
    "date_jeu",
    "suites",
    "inconnus",
    "enregistre_le"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "recu-reveil/1"},
    "id": {"type": "string", "pattern": "^rr-[0-9a-f]{24}$"},
    "cause": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["amorce", "billet", "autre"]},
        "id": {"type": "string", "minLength": 1},
        "adresse": {"type": "string", "minLength": 1}
      }
    },
    "rendu": {"type": "string", "minLength": 1},
    "habitant": {"type": "string", "minLength": 1},
    "session": {"type": "string", "minLength": 1},
    "date_jeu": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ref": {"type": "string", "minLength": 1},
    "suites": {
      "oneOf": [
        {
          "type": "object",
          "required": ["observation", "elements"],
          "additionalProperties": false,
          "properties": {
            "observation": {"const": "sorties_constatees"},
            "elements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type", "adresse"],
                "additionalProperties": false,
                "properties": {
                  "type": {"enum": ["artefact", "parole"]},
                  "adresse": {"type": "string", "minLength": 1},
                  "constat": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["observation", "elements"],
          "additionalProperties": false,
          "properties": {
            "observation": {"const": "aucune_sortie_visible"},
            "elements": {"type": "array", "maxItems": 0}
          }
        }
      ]
    },
    "inconnus": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "enregistre_le": {"type": "string", "format": "date-time"}
  }
}
