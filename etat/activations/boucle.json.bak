        "lieu:port-real": {
          "type": "observation",
          "apres": "Dès qu'elle a tourné le dos, un garçon sort du corps de garde et part au pas de course vers le haut de la ville, sans lanterne. Elle ne sait ni qui l'envoie, ni ce qu'il porte, ni s'il s'agit d'elle.",
          "resultat_id": "res:act:mysaria:4:1"
        },
        "etape:mysaria-manteaux-dor": {
