        "pers:aemond": {
          "type": "deplacement",
          "apres": "Aemond Targaryen en chemin dans Port-Réal, hors du Donjon Rouge, cap sur la Fosse aux Dragons ; il n'a pas reparu devant la porte du roi.",
          "resultat_id": "res:act:aemond:5:1"
