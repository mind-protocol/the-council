        "port-real": {
          "type": "observation",
          "apres": "À la première lumière du 29e, aucun porteur de cire royale ne monte ni ne descend les cours : le silence d'Aegon tient encore, et il reste une demi-journée avant midi.",
          "resultat_id": "res:act:aemond:5:2"
        },
        "activation:aemond:5fba1e19ab30": {
          "type": "progression_tache",
          "apres": "Ordre scellé parti pour la Fosse, feuillet daté du 29e, prince équipé et en route vers sa bête : tout ce qui dépend de lui est fait, et une borne est posée à midi du 29e — après quoi le silence vaudra refus d'Aegon et la voie de la représaille sera reprise devant le conseil avec ses chiffres.",
          "resultat_id": "res:act:aemond:5:3"
        }
      },
      "activites": [
